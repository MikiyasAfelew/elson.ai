# Copy to .env and fill in. Never commit .env.

# API
ELSON_MAX_UPLOAD_MB=50
# Where generated audio is kept (local store). Docker sets this itself.
ELSON_AUDIO_DIR=./data/audio

# Redis: two separate instances so cache eviction can never drop queued jobs (used from Sprint 2)
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6380/0

# LLM provider key (used from Sprint 7 for the glossary pass; leave empty until then)
LLM_API_KEY=
